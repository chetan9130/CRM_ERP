# Frontend environment variables
# VITE_API_URL = backend base URL — no trailing slash, no /api suffix.
# Vite bakes this in at BUILD TIME. Set it in Vercel before deploying.
#
# Local development:
VITE_API_URL=http://localhost:5000
#
# Production (set in Vercel → Project Settings → Environment Variables):
# VITE_API_URL=https://crm-erp-uo8j.onrender.com
