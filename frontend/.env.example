# Frontend environment variables
# Set VITE_API_URL to your Render backend URL (no trailing slash, no /api suffix)
# Vite bakes this value in at BUILD TIME — set it in Render before deploying.
#
# Local development:
VITE_API_URL=http://localhost:5000
#
# Production (set in Render → Environment Variables, not in this file):
# VITE_API_URL=https://YOUR-BACKEND.onrender.com
