PORT=5000
# Option A: Connection URL (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Option B: Individual Connection Attributes
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=crm_erp
DB_SSL=true

JWT_SECRET=your_super_secret_jwt_key_here
